command = ""

while True:
    command = input("> ").lower()
    if command == "start":
        print("Game started...Ready to go")
    elif command == "stop":
        print("Game stopped")
    elif command == "help":
        print('''
start - to start the game
stop - to stop the game
quit - to exit
''')
    elif command == "quit":
        break
    else:
        print("I dont understand that")
